# Porta HTTP do receptor
PORT=3000
# Segredo compartilhado com o emissor (HMAC-SHA256). Use um valor longo e aleatório.
WEBHOOK_SECRET=troque-por-um-segredo-forte
# Janela (s) aceita entre o timestamp da assinatura e o relógio do servidor (anti-replay)
SIGNATURE_TOLERANCE_SECONDS=300
# Quantidade de estações de preparo trabalhando em paralelo na cozinha
KITCHEN_STATIONS=2
# Tamanho máximo do corpo da requisição
BODY_LIMIT=100kb
# debug | info | warn | error | silent
LOG_LEVEL=info
