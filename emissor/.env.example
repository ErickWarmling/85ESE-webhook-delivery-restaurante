# Endpoint do webhook do restaurante
RECEIVER_URL=http://localhost:3000/webhooks/pedidos
# Segredo compartilhado com o receptor (deve ser idêntico ao do receptor)
WEBHOOK_SECRET=troque-por-um-segredo-forte
# Tempo limite de cada tentativa (ms)
REQUEST_TIMEOUT_MS=5000
# Novas tentativas em caso de falha de rede, 408, 429 ou 5xx
MAX_RETRIES=3
# Atraso base do backoff exponencial (ms)
RETRY_BASE_DELAY_MS=500
